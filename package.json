{
	"name": "christmas-watch-list-v2",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync && wrangler types || echo ''",
		"typecheck": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"cf:types": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"db:import-v1": "node --experimental-strip-types scripts/migrate-from-v1.ts",
		"deploy:staging": "pnpm build && wrangler deploy --env staging"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"better-auth": "^1.7.0",
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.59.0",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.11",
		"oxlint": "^1.88.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1"
	}
}
