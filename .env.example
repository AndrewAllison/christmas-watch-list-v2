# Node-side tooling (drizzle-kit, scripts/). Copy to .env — never commit real values.
# Worker runtime secrets live in .dev.vars locally and `wrangler secret put` remotely.

# V2 Neon database, DIRECT (non-pooled) connection string — used by drizzle-kit migrate.
# Must point at the V2 project/branch. NEVER the V1 production database.
DATABASE_URL=postgres://user:password@ep-xxxx.eu-west-2.aws.neon.tech/christmas_watch_list?sslmode=require

# Read-only role on the V1 Neon database, for scripts/migrate-from-v1.ts (Day 3+).
V1_DATABASE_URL=

# TMDB API read token for offline ingest scripts (Day 3+).
TMDB_API_TOKEN=

# Optional: point local `pnpm dev` at a different Postgres than wrangler.jsonc's localConnectionString.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://postgres:postgres@localhost:5432/christmas_watch_list
