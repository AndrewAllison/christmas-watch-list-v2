{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "christmas-watch-list-v2",
	"compatibility_date": "2026-10-19",
	// nodejs_compat: pg (TCP sockets) + Better Auth; includes AsyncLocalStorage.
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	"workers_dev": true,
	"preview_urls": true,
	// Local dev: wrangler connects straight to localConnectionString (no Hyperdrive).
	// Override with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgres://postgres:postgres@localhost:5432/christmas_watch_list"
		}
	],
	// `vars` and `secrets` are not inherited by environments: keep env.staging in sync.
	// EMAIL_FROM is optional (see src/app.d.ts): Email OTP reports "not set up" until it's a var or secret.
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:5173"
	},
	// Set locally in .dev.vars, remotely with `wrangler secret put <NAME> --env staging`.
	"secrets": {
		"required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "RESEND_API_KEY"]
	},
	"env": {
		// Staging on *.workers.dev only — no custom domain/routes until cutover.
		"staging": {
			"name": "christmas-watch-list-v2-staging",
			"workers_dev": true,
			// Created with `wrangler hyperdrive create ... --caching-disabled` (docs/decisions.md D1–D3).
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "7b90cabc6f1f41db842652f5b029bc42",
					"localConnectionString": "postgres://postgres:postgres@localhost:5432/christmas_watch_list"
				}
			],
			"vars": {
				"BETTER_AUTH_URL": "https://christmas-watch-list-v2-staging.andrew-allison0411-6bb.workers.dev" // pragma: allowlist secret
			},
			"secrets": {
				"required": [
					"BETTER_AUTH_SECRET",
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"RESEND_API_KEY"
				]
			}
		}
	}
}
