{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "christmas-watch-list-v2",
	"compatibility_date": "2026-10-19",
	// nodejs_compat: postgres.js (TCP sockets) + Better Auth; includes AsyncLocalStorage.
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	"workers_dev": true,
	"preview_urls": true,
	// Local dev: wrangler connects straight to localConnectionString (no Hyperdrive).
	// Override with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgres://postgres:postgres@localhost:5432/christmas_watch_list"
		}
	],
	"env": {
		// Staging on *.workers.dev only — no custom domain/routes until cutover.
		"staging": {
			"name": "christmas-watch-list-v2-staging",
			"workers_dev": true,
			// BLOCKER: replace with the id from
			// `wrangler hyperdrive create cwl-v2-staging --connection-string="<V2 Neon URL>" --caching-disabled`
			// (see docs/decisions.md D1–D3).
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "00000000000000000000000000000000",
					"localConnectionString": "postgres://postgres:postgres@localhost:5432/christmas_watch_list"
				}
			]
		}
	}
}
